{
  "buildCommand": "npm run proof:all && npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/operator/:path*",
      "destination": "/owner",
      "permanent": false
    },
    {
      "source": "/device",
      "destination": "/crew/bus",
      "permanent": false
    },
    {
      "source": "/terminal",
      "destination": "/crew/door",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app/((?!assets/|fonts/|voice/|sw\\.js|workbox-|registerSW\\.js|manifest\\.webmanifest|.*\\.png|.*\\.svg|.*\\.ico).*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/crew/((?!assets/|fonts/|voice/|sw\\.js|workbox-|registerSW\\.js|manifest\\.webmanifest|.*\\.png|.*\\.svg|.*\\.ico).*)",
      "destination": "/crew/index.html"
    },
    {
      "source": "/crew",
      "destination": "/crew/index.html"
    },
    {
      "source": "/owner/((?!assets/|fonts/|voice/|sw\\.js|workbox-|registerSW\\.js|manifest\\.webmanifest|.*\\.png|.*\\.svg|.*\\.ico).*)",
      "destination": "/owner/index.html"
    },
    {
      "source": "/owner",
      "destination": "/owner/index.html"
    },
    {
      "source": "/staff/((?!assets/|fonts/|voice/|sw\\.js|workbox-|registerSW\\.js|manifest\\.webmanifest|.*\\.png|.*\\.svg|.*\\.ico).*)",
      "destination": "/staff/index.html"
    },
    {
      "source": "/staff",
      "destination": "/staff/index.html"
    },
    {
      "source": "/((?!app/|crew/|owner/|staff/|assets/|fonts/|voice/|sw\\.js|workbox-|registerSW\\.js|manifest\\.webmanifest|.*\\.png|.*\\.svg|.*\\.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.basemaps.cartocdn.com; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://epay.esewa.com.np https://rc-epay.esewa.com.np"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/demo(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.basemaps.cartocdn.com; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://epay.esewa.com.np https://rc-epay.esewa.com.np"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/crew/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/owner/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/staff/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
