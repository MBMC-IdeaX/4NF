# /etc/bhada/validator.env — one validator, one door.
BHADA_DOOR=A

# 'door' on a bus whose meter announces the vehicle key; 'vehicle' when this box
# is the bus's only unit (no phones): it makes the key and announces it itself.
BHADA_ROLE=door
BHADA_VEHICLE=BA2KHA4412
BHADA_CAPACITY=42
BHADA_DATA_DIR=/var/lib/bhada

# GM65/GM805 in USB virtual-COM mode. /dev/serial0 if it is on the UART instead.
BHADA_SCANNER=/dev/ttyACM0
BHADA_SCANNER_BAUD=9600

# PN532 in HSU mode on the Pi's UART (GPIO 14/15).
BHADA_PN532=/dev/serial0

# The meter box, over a USB-RS485 adapter. 'none' until there is one.
BHADA_RS485=none
BHADA_RS485_BAUD=115200

# Where distance comes from: 'meter' (the RS-485 heartbeat), 'simulated' on a
# bench, or 'none'. A vehicle CAN adapter would be a new value here.
BHADA_ODOMETER=meter

# The ILI9341 framebuffer.
BHADA_DISPLAY=/dev/fb1
BHADA_GPIO=pinctrl
BHADA_RTC=/sys/class/rtc/rtc0

# GPIO for the vehicle feed sense (optocoupler). 'none' unless the validator
# runs from the permanent supply and senses the switched one — see README.
BHADA_FEED_SENSE=none

# Upload when there is a network (4G dongle, hotspot or depot Wi-Fi).
# Validation never needs it. The URL is the sync Edge Function; the key is the
# public anon key the website already ships.
BHADA_SYNC_URL=
BHADA_ANON_KEY=
